# Postgres connection for the web app — use the least-privilege role (RLS applies to it)
DATABASE_URL=postgresql://hunscout_web:hunscout_web@localhost:5432/hunscout
# PG_SSL=true            # Supabase / managed Postgres
WORKSPACE_ID=lajosmizse_vlc
# Set both to enable the staff login (leave WORKSPACE_PASSCODE empty for local dev)
WORKSPACE_PASSCODE=
AUTH_SECRET=change-me-to-a-long-random-string

# --- scheduled MLSZ sync (web /api/cron/sync -> internal etl service) ---
# Vercel sends "Authorization: Bearer $CRON_SECRET" with every schedule run.
CRON_SECRET=change-me
# Injected by the vercel.json service binding on Vercel and by `vercel dev` — do NOT set it there.
# Only for running without `vercel dev`: point it at `cd etl && uvicorn api:app --port 8000`.
# ETL_URL=http://localhost:8000
# Optional shared secret checked by the etl service (set the same value for both services).
# ETL_INTERNAL_TOKEN=
