{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "etl",
          "format": "url",
          "env": "ETL_URL"
        }
      ]
    },
    "etl": {
      "root": "etl",
      "framework": "fastapi",
      "entrypoint": "api:app",
      "functions": {
        "api.py": {
          "maxDuration": "max",
          "maxConcurrency": 1,
          "excludeFiles": "{tests/**,.pytest_cache/**,Dockerfile,requirements-dev.txt}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "schedules": {
    "sync-nb3-dk-mon": {
      "schedule": "0 6 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/nb3_dk"
    },
    "sync-bk1-mon": {
      "schedule": "15 6 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/bk1"
    },
    "sync-pest1-mon": {
      "schedule": "30 6 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/pest1"
    },
    "sync-blsz1-mon": {
      "schedule": "45 6 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/blsz1"
    },
    "sync-jnsz1-mon": {
      "schedule": "0 7 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/jnsz1"
    },
    "sync-bk2d-mon": {
      "schedule": "15 7 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/bk2d"
    },
    "sync-bk2e-mon": {
      "schedule": "30 7 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/bk2e"
    },
    "sync-pest2e-mon": {
      "schedule": "45 7 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/pest2e"
    },
    "sync-pest2d-mon": {
      "schedule": "0 8 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/pest2d"
    },
    "sync-blsz2-mon": {
      "schedule": "15 8 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/blsz2"
    },
    "sync-mk-mon": {
      "schedule": "30 8 * * 1",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/mk"
    },
    "sync-nb3-dk-wed": {
      "schedule": "0 21 * * 3",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/nb3_dk"
    },
    "sync-bk1-wed": {
      "schedule": "15 21 * * 3",
      "timezone": "Europe/Budapest",
      "path": "/api/cron/sync/bk1"
